{
  "name": "gestao-escolar",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build api-gateway",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main.js",
    "lint": "oxlint --type-aware apps/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "build:all": "nest build api-gateway && nest build alunos && nest build professores && nest build turmas-disciplinas && nest build avaliacoes-notas && nest build comunicacao",
    "prisma:alunos:validate": "prisma validate --config apps/alunos/prisma.config.ts",
    "test:alunos:connection": "vitest run --config apps/alunos/test/vitest.connection.config.ts",
    "prisma:alunos:generate": "prisma generate --config apps/alunos/prisma.config.ts",
    "build:alunos": "nest build alunos",
    "start:alunos": "nest start alunos",
    "start:alunos:dev": "nest start alunos --watch",
    "start:alunos:prod": "node dist/apps/alunos/main.js",
    "build:professores": "nest build professores",
    "start:professores": "nest start professores",
    "start:professores:dev": "nest start professores --watch",
    "start:professores:prod": "node dist/apps/professores/main.js",
    "build:turmas-disciplinas": "nest build turmas-disciplinas",
    "start:turmas-disciplinas": "nest start turmas-disciplinas",
    "start:turmas-disciplinas:dev": "nest start turmas-disciplinas --watch",
    "start:turmas-disciplinas:prod": "node dist/apps/turmas-disciplinas/main.js",
    "build:avaliacoes-notas": "nest build avaliacoes-notas",
    "start:avaliacoes-notas": "nest start avaliacoes-notas",
    "start:avaliacoes-notas:dev": "nest start avaliacoes-notas --watch",
    "start:avaliacoes-notas:prod": "node dist/apps/avaliacoes-notas/main.js",
    "build:comunicacao": "nest build comunicacao",
    "start:comunicacao": "nest start comunicacao",
    "start:comunicacao:dev": "nest start comunicacao --watch",
    "start:comunicacao:prod": "node dist/apps/comunicacao/main.js",
    "prisma:professores:validate": "prisma validate --config apps/professores/prisma.config.ts",
    "prisma:professores:generate": "prisma generate --config apps/professores/prisma.config.ts",
    "prisma:turmas-disciplinas:validate": "prisma validate --config apps/turmas-disciplinas/prisma.config.ts",
    "prisma:turmas-disciplinas:generate": "prisma generate --config apps/turmas-disciplinas/prisma.config.ts",
    "prisma:avaliacoes-notas:validate": "prisma validate --config apps/avaliacoes-notas/prisma.config.ts",
    "prisma:avaliacoes-notas:generate": "prisma generate --config apps/avaliacoes-notas/prisma.config.ts",
    "prisma:comunicacao:validate": "prisma validate --config apps/comunicacao/prisma.config.ts",
    "prisma:comunicacao:generate": "prisma generate --config apps/comunicacao/prisma.config.ts",
    "auth:hash": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "dotenv": "18.0.9",
    "jose": "6.2.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
