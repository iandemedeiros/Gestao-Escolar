generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "esm"
}

datasource db {
  provider = "mysql"
}

model aluno {
  id                   String    @id @db.Char(36)
  nome                 String    @db.VarChar(150)
  data_nascimento      DateTime  @db.Date
  cpf                  String    @unique(map: "cpf") @db.VarChar(11)
  email                String    @unique(map: "email") @db.VarChar(150)
  senha_hash           String    @db.VarChar(255)
  endereco_rua         String?   @db.VarChar(150)
  endereco_numero      String?   @db.VarChar(10)
  endereco_complemento String?   @db.VarChar(100)
  endereco_bairro      String?   @db.VarChar(100)
  endereco_cidade      String?   @db.VarChar(100)
  endereco_estado      String?   @db.Char(2)
  endereco_cep         String?   @db.VarChar(9)
  contato              contato[]
}

model contato {
  id       String  @id @db.Char(36)
  aluno_id String  @db.Char(36)
  telefone String? @db.VarChar(15)
  celular  String? @db.VarChar(15)
  email    String? @db.VarChar(150)
  aluno    aluno   @relation(fields: [aluno_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_contato_aluno")

  @@index([aluno_id], map: "fk_contato_aluno")
}
