# Copy to apps/alunos/.env only when database access is authorized.
# Use the schema/database assigned to you by the faculty.
# Percent-encode special characters in USER and PASSWORD.
DATABASE_URL="mysql://USER:PASSWORD@MYSQL_HOST:3306/SCHEMA_DO_ALUNO"


# Se tiver caracteres especiais no USER e PASSWORD, use percent-encoding. Exemplo: minhasenha@123 -> minhasenha%40123